# Copy this file to .env.local and fill in values. Do not commit .env.local.

# Session signing (required)
SESSION_SECRET=your-secret-at-least-32-chars

# Postgres (Vercel Postgres – set in Vercel or paste POSTGRES_URL here)
# POSTGRES_URL=postgres://...
# POSTGRES_URL_NON_POOLING=postgres://...  # optional; for migrations/schema from Node

# Email – password reset & automated emails (see README)
RESEND_API_KEY=
# EMAIL_FROM=Reach For The Stars <noreply@yourdomain.com>
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Admin (optional – or create first admin at /admin/setup)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD_HASH=

# Stripe (for subscriptions)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=whsec_...   # from Stripe Dashboard → Developers → Webhooks
# NEXT_PUBLIC_STRIPE_MODE=demo
# DEMO_SKIP_STRIPE=true   # when true, signup skips Stripe and activates membership

# Vercel Blob – audio uploads (Admin Content → Audio Library, member CGMR)
# BLOB_READ_WRITE_TOKEN=

# Moderator submission (POST /api/moderators with x-submission-key)
# SUBMISSION_KEY=

# Report an issue – where to send member reports (optional; defaults to EMAIL_FROM or support)
# REPORT_ISSUE_EMAIL=support@yourdomain.com
