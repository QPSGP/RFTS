# Copy to .env.local and fill in values before running locally or deploying.

# Session & admin
SESSION_SECRET=generate-a-long-random-string
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_SETUP_TOKEN=

# Public site URLs (set both to production apex before go-live; redeploy after changing)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Your affiliate code on blog/landing CTAs and guest signup links (from My Profile → Affiliate program)
# NEXT_PUBLIC_MARKETING_AFFILIATE_REF=ABCD1234
# Optional: affiliate payout launch period end (YYYY-MM-DD). Through this date minimum is $25; after, $50.
# NEXT_PUBLIC_AFFILIATE_PAYOUT_LAUNCH_END=2027-06-18
# Production (Vercel): https://reachforthestars.today

# Stripe (use test keys locally; live keys + webhook on Vercel production)
STRIPE_SECRET_KEY=sk_test_replace
STRIPE_WEBHOOK_SECRET=
STRIPE_MODE=demo
NEXT_PUBLIC_STRIPE_MODE=demo
# Enable PayPal + ACH Direct Debit in Stripe Dashboard → Settings → Payment methods (live and test).
# DEMO_SKIP_STRIPE=true

# Life Guidance Discovery / Goal Manifestation ($397 product)
# Default: admin-only preview (super-admin /admin/lgd). Set false to open to members/facilitators/public.
LGD_ADMIN_ONLY=true
STRIPE_LGD_PRODUCT_ID=prod_I7hhOenF6qstnH
# Optional: pin a Price ID; otherwise the active $397 price on the product is used.
# STRIPE_LGD_PRICE_ID=price_...
NEXT_PUBLIC_LGD_PRICE_DISPLAY=$397
LGD_PRICE_CENTS=39700
# Voice production: ai_internal (default) or studio_external (e.g. Paul Griffin files)
# LGD_VOICE_PRODUCTION=ai_internal
# AI CGMR generate (Admin/Facilitator → Produce CGMR). Without this, use upload/assign.
# OPENAI_API_KEY=
# Default model uses hypnotic style instructions (smooth sleep delivery). Override if needed:
# LGD_OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Pace: 0.25–4.0 (default 0.78 = overnight hypnotic). Try 0.70 for deeper slowdown.
# LGD_OPENAI_TTS_SPEED=0.78
# Optional full override of hypnotic instructions (otherwise built per voice tone):
# LGD_OPENAI_TTS_INSTRUCTIONS=
# Optional per-catalog voice overrides (shimmer, coral, onyx, sage, …)
# LGD_OPENAI_VOICE_TERRY=shimmer
# LGD_OPENAI_VOICE_ASSOCIATE_WARM=shimmer
# LGD_OPENAI_VOICE_ASSOCIATE_CLEAR=coral
# LGD_OPENAI_VOICE_ASSOCIATE_DEEP=onyx

# Email (Resend API — not SMTP)
RESEND_API_KEY=
EMAIL_FROM=Reach For The Stars <onboarding@resend.dev>
# Production after Resend domain verify: Reach For The Stars <noreply@reachforthestars.today>
# Staff recipient lists (welcome CC, staff BCC, report To, affiliate CC, issue-resolved BCC)
# are editable in Admin → Email settings (Postgres). These env vars only seed the DB on first use:
# WELCOME_EMAIL_CC=
# EMAIL_STAFF_BCC=
# REPORT_ISSUE_EMAIL=Richard@richardleeweatherman.com
# AFFILIATE_EMAIL_CC=
# ISSUE_RESOLVED_STAFF_BCC=
# ISSUE_RESOLVED_STAFF_BCC_UNTIL=2026-09-16
REPORT_ISSUE_EMAIL=Richard@richardleeweatherman.com

# Postgres (Vercel Postgres connection string)
POSTGRES_URL=

# Vercel Cron (monthly affiliate Connect payouts). Vercel sends Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

# Moderation submissions
SUBMISSION_KEY=

# Microsoft Clarity (RFTS Production default project id)
# NEXT_PUBLIC_CLARITY_PROJECT_ID=gqjkbi3vuk
# NEXT_PUBLIC_CLARITY_ENABLED=false

# Google Analytics 4 (default G-LE8W4KTMLK)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-LE8W4KTMLK
# NEXT_PUBLIC_GA_ENABLED=false

# Optional crypto panel
NEXT_PUBLIC_TREASURY_ADDRESS=
